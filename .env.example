# Copie este arquivo para .env.local (app Next.js) e/ou .env (docker-compose)
# e preencha os valores. Veja o ONBOARDING.md para o passo a passo completo.

# ── Next.js / Supabase (cliente e servidor) ──────────────────────────
# URL pública do gateway Supabase/Kong. Local: http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
# Chave anônima (anon key) do Supabase — mesmo valor de SUPABASE_ANON_KEY abaixo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL usada quando o Next.js roda DENTRO do container Docker e precisa
# acessar o Kong pela rede interna (ex: http://kong:8000). Opcional fora do Docker.
SUPABASE_URL_INTERNAL=

# URL pública da aplicação, usada em redirects de OAuth e links de compartilhamento.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lista de e-mails autorizados a autenticar, separados por vírgula.
# Se vazio, qualquer usuário pode se cadastrar/logar.
ALLOWED_EMAILS=

# ── Docker Compose (infraestrutura Supabase local) ───────────────────
# Senha do usuário postgres no container do banco.
POSTGRES_PASSWORD=

# Segredo usado para assinar/verificar JWTs (GoTrue, PostgREST, Kong).
# Use uma string de pelo menos 32 caracteres.
JWT_SECRET=

# Chaves usadas pelo Kong/Storage para autenticar requisições anônimas e administrativas.
# Devem ser JWTs assinados com o mesmo JWT_SECRET acima (role "anon" e "service_role").
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
